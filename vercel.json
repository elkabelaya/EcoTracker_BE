{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "buildCommand": "npm install --allow-scripts=@prisma/client,@prisma/engines,prisma && npx prisma generate --schema=./prisma/schema-vercel.prisma"
}
