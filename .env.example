# ============================================
# LOCAL DEVELOPMENT (SQLite)
# ============================================
# Для локальной разработки используйте SQLite
# Скопируйте этот блок в .env.local

DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET="your-access-token-secret-change-this-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-this-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development

# ============================================
# VERCEL PRODUCTION (PostgreSQL - Neon)
# ============================================
# Для Vercel настройте эти переменные в панели управления:
# https://vercel.com/dashboard/project/YOUR_PROJECT/settings/environment%20variables

DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/ecotracker?sslmode=require"
JWT_ACCESS_SECRET="your-production-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-production-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=production
