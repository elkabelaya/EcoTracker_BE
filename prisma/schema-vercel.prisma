// Схема для Vercel с PostgreSQL (Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  
  habits       Habit[]
  refreshToken RefreshToken[]

  @@map("user_table")
}

model Habit {
  id          String   @id @default(uuid())
  title       String
  category    Int      // 0=TRANSPORT, 1=WASTE, 2=WATER, 3=PLASTIC
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  syncVersion Int      @default(1)
  isDeleted   Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, title, category])
  @@index([userId])
  @@index([userId, category])
  @@map("habit_table")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
