{
  "name": "ecotracker-be",
  "version": "1.0.0",
  "description": "EcoTracker Backend API with SQLite (local) / PostgreSQL (Vercel) and JWT authentication",
  "main": "dist/index.js",
  "scripts": {
    "dev:local": "DATABASE_URL=file:./dev.db ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate:local": "prisma generate --schema=./prisma/schema-local.prisma",
    "prisma:generate:vercel": "prisma generate --schema=./prisma/schema-vercel.prisma",
    "prisma:push:local": "prisma db push --schema=./prisma/schema-local.prisma",
    "prisma:push:vercel": "prisma db push --schema=./prisma/schema-vercel.prisma",
    "postinstall": "prisma generate --schema=./prisma/schema-vercel.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "prisma": "^5.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@prisma/client": "$@prisma/client",
    "prisma": "$prisma"
  }
}
